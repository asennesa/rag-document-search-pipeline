# Copy to .env from the repository root. Never commit .env.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_embeddings
QDRANT_TIMEOUT_SECONDS=10
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_HNSW_EF=128
# Thresholds are vector KB, not point counts.
QDRANT_FULL_SCAN_THRESHOLD_KB=10000
QDRANT_INDEXING_THRESHOLD_KB=20000
QDRANT_UPSERT_BATCH_SIZE=64
QDRANT_RETRIES=3
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=32
EMBEDDING_THREADS=2
EMBEDDING_CACHE_DIR=.cache/fastembed
GENERATION_CACHE_DIR=.cache/generation
MODEL_ASSETS_PATH=model_assets.json
CHUNK_SIZE=256
CHUNK_OVERLAP=40
SEARCH_TOP_K=5
SEARCH_MAX_TOP_K=20
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=4096
RAG_MAX_CONTEXT_TOKENS=3000
RAG_MAX_OUTPUT_TOKENS=512
RAG_CONTEXT_SAFETY_TOKENS=128
RAG_TEMPERATURE=0
# OLLAMA_NO_CLOUD=1 belongs in the Ollama SERVER environment in Phase 6.
DOCUMENTS_DIR=data/sample_docs
SOURCE_NAMESPACE=sample-policies
UPLOADS_DIR=data/uploads
INGESTION_LOCK_DIR=.runtime/locks
UPLOAD_MAX_BYTES=20971520
PDF_MAX_PAGES=500
EXTRACTED_MAX_CHARACTERS=2000000
LOG_LEVEL=INFO
